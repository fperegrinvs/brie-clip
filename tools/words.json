  },
  {
   "start": 59.98,
   "end": 62.98,
   "text": "Cocodrilo, uma cove de patiça estreando um trio"
  },
  {
   "start": 63.84,
   "end": 66.48,
   "text": "Pipizinha, corre pela cozinha"
  },
  {
   "start": 66.48,
   "end": 70.18,
   "text": "Pin, pin, pin, pin, a nossa pequenina"
  },
  {
   "start": 70.18,
   "end": 73.34,
   "text": "Zoomies, zoomies, quem vai segurar?"
  },
  {
   "start": 73.52,
   "end": 77.42,
   "text": "Faz trivoltas pela sala sem parar"
  },
  {
   "start": 77.42,
   "end": 80.54,
   "text": "Cove-meioca, linha o bom-bom"
  },
  {
   "start": 80.54,
   "end": 84.56,
   "text": "Quatro patas contra o mundo feito o trovão"
  },
  {
   "start": 84.56,
   "end": 87.72,
   "text": "Cove-meioca, linha o bom-bom"
  },
  {
   "start": 87.72,
   "end": 97.8,
   "text": "Quatro patas contra o mundo feito um trovão"
  },
  {
   "start": 97.8,
   "end": 101.26,
   "text": "Corredor é pista, papete é trampolim"
  },
  {
   "start": 101.26,
   "end": 105.26,
   "text": "Dobra a esquina e vem voando para cima de mim"
  },
  {
   "start": 105.26,
   "end": 109.06,
   "text": "Um crocodilo fugindo do zoológico"
  },
  {
   "start": 109.06,
   "end": 113.34,
   "text": "E um pão de queijo intergaláctico"
  },
  {
   "start": 113.34,
   "end": 116.98,
   "text": "Para dois segundos só pra respirar"
  },
  {
   "start": 116.98,
   "end": 124.66,
   "text": "Já liga o turbo, volta a acelerar"
  },
  {
   "start": 125.88,
   "end": 127.72,
   "text": "Vai pra cadeia"
  },
  {
   "start": 127.72,
   "end": 129.16,
   "text": "Não, não, não"
  },
  {
   "start": 129.16,
   "end": 131.34,
   "text": "Vai dormir de bunda quente"
  },
  {
   "start": 131.34,
   "end": 134.96,
   "text": "Roubo meu pedredão"
  },
  {
   "start": 134.96,
   "end": 138.44,
   "text": "Pin, pin, pin, pinha"
  },
  {
   "start": 138.44,
   "end": 142.26,
   "text": "Não recomeça"
  },
  {
   "start": 142.26,
   "end": 143.76,
   "text": "Pin, pinzinha"
  },
  {
   "start": 143.76,
   "end": 145.62,
   "text": "Corre pela cozinha"
  },
  {
   "start": 145.62,
   "end": 149.32,
   "text": "Pim-pim-pim-pim, a nossa pequenina"
  },
  {
   "start": 149.32,
   "end": 152.5,
   "text": "Zoomie-se, zoomie-se, quem vai segurar?"
  },
  {
   "start": 152.7,
   "end": 156.56,
   "text": "Faz três voltas pela sala sem parar"
  },
  {
   "start": 156.56,
   "end": 158.08,
   "text": "Gove, New Yorker!"
  },
  {
   "start": 158.38,
   "end": 159.7,
   "text": "Leão, pom-pom!"
  },
  {
   "start": 159.76,
   "end": 163.74,
   "text": "Quatro patas contra o mundo feito o trovão"
  },
  {
   "start": 163.74,
   "end": 165.2,
   "text": "Gove, New Yorker!"
  },
  {
   "start": 165.34,
   "end": 166.82,
   "text": "Leão, pom-pom!"
  },
  {
   "start": 167.08,
   "end": 171.84,
   "text": "Quatro patas contra o mundo feito o trovão"
  },
  {
   "start": 171.84,
   "end": 174.86,
   "text": "Um rio em Clover Lake"
  },
  {
   "start": 174.86,
   "end": 178.28,
   "text": "Uma nova aventura cada dia"
  },
  {
   "start": 178.28,
   "end": 180.02,
