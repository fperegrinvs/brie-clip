  {
   "start": 1.16,
   "end": 8.82,
   "text": "From the hidden of cloverly, pale breeze."
  },
  {
   "start": 12.62,
   "end": 16.0,
   "text": "Pim pim pim pinha. Brizinha, furacão de algodão."
  },
  {
   "start": 40.46,
